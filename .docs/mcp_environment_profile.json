{
  "schema_version": 1,
  "profile_id": "drake",
  "description": "MCP environment profile for Drake — UI/API development toolkit and future Drake MCP host.",
  "default_tier": "dev",
  "credential_policy": {
    "forbidden_in_tiers": ["dev"],
    "human_gate_tiers": ["production"]
  },
  "tiers": {
    "dev": {
      "description": "Local development.",
      "mcp_servers": {
        "github": {
          "enabled": true,
          "transport": "stdio",
          "command": "npx",
          "args": ["-y", "@anthropic/mcp-server-github"]
        },
        "filesystem": {
          "enabled": true,
          "transport": "stdio",
          "command": "npx",
          "args": ["-y", "@anthropic/mcp-server-filesystem", "."]
        },
        "shell": {
          "enabled": true,
          "transport": "stdio",
          "command": "sh",
          "args": ["-c"]
        }
      }
    },
    "staging": {
      "description": "Hetzner VPS staging — Drake placeholder running on mcp-staging.spencervaradi.com/drake.",
      "mcp_servers": {
        "drake": {
          "enabled": true,
          "transport": "streamable_http",
          "url": "https://mcp-staging.spencervaradi.com/drake",
          "credential_refs": ["DRAKE_MCP_API_KEY"],
          "package_ref": "container:drake-api",
          "runtime_identity": "drake-mcp@staging",
          "notes": "Placeholder HTTP server; real MCP server implementation pending."
        },
        "github": {
          "enabled": true,
          "transport": "stdio",
          "command": "npx",
          "args": ["-y", "@anthropic/mcp-server-github"],
          "credential_refs": ["GH_TOKEN"]
        }
      }
    },
    "production": {
      "description": "Production tier — reserved.",
      "mcp_servers": {
        "drake": {
          "enabled": false,
          "transport": "streamable_http",
          "url": "https://mcp.spencervaradi.com/drake",
          "credential_refs": ["PROD_DRAKE_MCP_API_KEY"],
          "notes": "Reserved; enable only during approved production rollout."
        }
      }
    }
  }
}
